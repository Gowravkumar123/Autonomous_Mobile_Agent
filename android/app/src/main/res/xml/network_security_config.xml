<?xml version="1.0" encoding="utf-8"?>
<!--
  The on-prem backend is plain HTTP/WS (no TLS yet), which Android blocks by default
  on API 28+. Permit cleartext ONLY to the backend host for testing. Once the server
  is behind HTTPS/WSS, remove this and switch the app URLs to https:// / wss://.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">37.27.53.14</domain>
        <!-- Loopback never leaves the phone: used when testing against a dev backend
             through `adb reverse tcp:8033 tcp:8033` (build with -PbackendHost=127.0.0.1:8033). -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
