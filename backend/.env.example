# ---- LLM providers ----
# Primary: Groq (free tier). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Current Groq free-tier production model (llama-3.3-70b-versatile was retired
# from free/dev tiers on 2026-08-16). Alternatives: openai/gpt-oss-20b (smaller/faster).
GROQ_MODEL=openai/gpt-oss-120b

# Backup: Google Gemini Flash (free tier). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Use the current Flash model; gemini-2.0/2.5-flash are retired.
GEMINI_MODEL=gemini-3.8-flash

# If BOTH keys are empty, the backend uses a built-in heuristic "mock" LLM,
# so the whole pipeline still runs end-to-end for demos/tests.

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Safety ----
# Hard spending ceiling (in your currency units). Any amount >= this is always
# blocked for user approval, regardless of what the model proposes.
SPEND_APPROVAL_THRESHOLD=0

# ---- Scaling (multiple workers) ----
# Shared state + cross-worker routing. Required to run more than one worker
# (uvicorn --workers N, or several hosts behind a load balancer): device sockets,
# approvals/answers, pause/cancel and event streams are routed between workers.
# Empty = single worker, everything in-process.
REDIS_URL=
# CLUSTER_ENABLED=false   # keep using Redis for limits/pairing but don't route
